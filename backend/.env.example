# Database connection string
# For local SQLite: file:./dev.db
# For PostgreSQL: postgresql://username:password@localhost:5432/acowale_crm?schema=public
DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# Node Environment (development, production, test)
NODE_ENV="development"

# JWT secret key for signing auth tokens (at least 32 characters recommended)
JWT_SECRET="some_very_long_and_extremely_secure_secret_key_12345"

# Allowed CORS Origin
CORS_ORIGIN="http://localhost:5173"
